{
  "name": "thrive65-site",
  "private": true,
  "description": "CSS post-processing for the Jekyll build output (_site), plus the enrollment page data prep (scripts/enrollment).",
  "scripts": {
    "build:css": "postcss _site/assets/css/main.css -o _site/assets/css/main.css --no-map",
    "data:enrollment": "node scripts/enrollment/prepare.mjs"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "cssnano": "^7.0.6",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.0",
    "postcss-custom-media": "^11.0.5",
    "postcss-preset-env": "^10.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
